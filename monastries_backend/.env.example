# Server Configuration
NODE_ENV=development
PORT=3777

# Database Configuration
DATABASE_CONNECTION_URI=mongodb://localhost:27017/monasteries
# For production, use MongoDB Atlas or your production database URL
# DATABASE_CONNECTION_URI=mongodb+srv://username:password@cluster.mongodb.net/monasteries

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Logging
LOG_LEVEL=info
# Options: trace, debug, info, warn, error, fatal

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cookie Configuration
COOKIE_SECURE=false
# Set to true in production with HTTPS
COOKIE_SAME_SITE=Lax
# Options: Strict, Lax, None
