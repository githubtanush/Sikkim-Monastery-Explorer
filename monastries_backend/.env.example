# Server Configuration
NODE_ENV=development
PORT=3777

# Database Configuration
DATABASE_CONNECTION_URI=mongodb://localhost:27017/monasteries
# For production, use MongoDB Atlas or your production database URL
# DATABASE_CONNECTION_URI=mongodb+srv://username:password@cluster.mongodb.net/monasteries

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Cookie Configuration
COOKIE_SECURE=false
# Set to true in production with HTTPS
COOKIE_SAME_SITE=Lax
# Options: Strict, Lax, None
COOKIE_MAX_AGE=604800000
# 7 days in milliseconds (7 * 24 * 60 * 60 * 1000)

# API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Logging
LOG_LEVEL=info
# Options: trace, debug, info, warn, error, fatal

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated list of allowed origins

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds (15 * 60 * 1000)
RATE_LIMIT_MAX_REQUESTS=100
# Maximum requests per window

AUTH_RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# Maximum login attempts per window

CREATE_RATE_LIMIT_WINDOW_MS=3600000
# 1 hour in milliseconds (60 * 60 * 1000)
CREATE_RATE_LIMIT_MAX_REQUESTS=10
# Maximum create requests per hour

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
# Maximum items per page

# Contribution System
CONTRIBUTION_DEFAULT_POINTS=100
# Default points awarded for approved contributions
CONTRIBUTION_EXPLORER_THRESHOLD=100
# Points needed for Explorer badge
CONTRIBUTION_PATHFINDER_THRESHOLD=500
# Points needed for Pathfinder badge
CONTRIBUTION_GUARDIAN_THRESHOLD=1000
# Points needed for Guardian badge

# Review System
REVIEW_MIN_LENGTH=5
# Minimum characters for review comment
REVIEW_MAX_LENGTH=1000
# Maximum characters for review comment

# Travel Guide
TRAVEL_GUIDE_SEARCH_RADIUS=10000
# Default search radius in meters (10km)
TRAVEL_GUIDE_CACHE_DURATION=604800000
# Cache duration in milliseconds (7 days)
TRAVEL_GUIDE_AVERAGE_SPEED=40
# Average travel speed in km/h for duration calculation

# Location/Guide Profile
BIO_MIN_LENGTH=50
# Minimum characters for bio
BIO_MAX_LENGTH=1000
# Maximum characters for bio

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30000
# Timeout in milliseconds before forced shutdown (30 seconds)

